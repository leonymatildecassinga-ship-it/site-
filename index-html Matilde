<script>
// ===== CONFIGURAÇÃO =====
// Número com indicativo e sem + (Angola: 244)
const WHATSAPP_NUMBER = "244958528527";

const TYPES = [
  {id:"inst", name:"Site institucional", min:350000, max:975000},
  {id:"land", name:"Landing page", min:175000, max:350000},
  {id:"shop", name:"Loja virtual", min:500000, max:1700000}
];
const FEATURES = [
  {id:"form", name:"Formulário de contacto", min:0, max:0},
  {id:"book", name:"Marcações online", min:80000, max:180000},
  {id:"blog", name:"Blog", min:60000, max:130000},
  {id:"seo", name:"SEO avançado", min:150000, max:350000},
  {id:"lang", name:"Vários idiomas", min:80000, max:200000},
  {id:"pay", name:"Pagamentos online", min:150000, max:350000}
];
const TIMES = [
  {id:"norm", name:"2 dias", mult:1}
];
// ========================

const $ = s => document.querySelector(s);
const eur = n => Math.round(n).toLocaleString("pt-PT",{maximumFractionDigits:0}).replace(/\u00a0/g,".").replace(/\s/g,".") + " Kz";
const num = n => eur(n).replace(" Kz","");
const rng = o => o.max ? num(o.min)+" – "+num(o.max)+" Kz" : "incluído";
const state = {type:"inst", feats:new Set(), time:"norm"};

function opt(group, kind, o, checked, hint){
  const id = kind + "-" + o.id;
  const d = document.createElement("div");
  d.className = "opt";
  d.innerHTML = `<input type="${kind==="feat"?"checkbox":"radio"}" name="${kind}" id="${id}" value="${o.id}" ${checked?"checked":""}><label for="${id}">${o.name}<small>${hint}</small></label>`;
  d.querySelector("input").addEventListener("change", e => {
    if(kind==="type") state.type = o.id;
    else if(kind==="time") state.time = o.id;
    else e.target.checked ? state.feats.add(o.id) : state.feats.delete(o.id);
    render();
  });
  $(group).appendChild(d);
}
TYPES.forEach((o,i)=>opt("#g-type","type",o,i===0,rng(o)));
FEATURES.forEach(o=>opt("#g-feat","feat",o,false,o.max?"+ "+rng(o):rng(o)));

function render(){
  const t = TYPES.find(x=>x.id===state.type);
  const fs = FEATURES.filter(f=>state.feats.has(f.id));
  const tm = TIMES.find(x=>x.id===state.time);
  const r5 = n => Math.round(n/5000)*5000;
  const low = r5((t.min + fs.reduce((a,f)=>a+f.min,0))*tm.mult);
  const high = r5((t.max + fs.reduce((a,f)=>a+f.max,0))*tm.mult);
  let html = `<li><span>${t.name}</span><span>${rng(t)}</span></li>`;
  fs.forEach(f=>html += `<li><span>${f.name}</span><span>${rng(f)}</span></li>`);
  html += `<li><span>Prazo de entrega</span><span>${tm.name}</span></li>`;
  $("#lines").innerHTML = html;
  $("#total").textContent = eur(low) + " a " + eur(high);
  const msg = `Olá! Fiz uma simulação no site da Nuxes Loop Technology:\n\n` +
    `Projeto: ${t.name}\n` +
    `Funcionalidades: ${fs.length ? fs.map(f=>f.name).join(", ") : "nenhuma extra"}\n` +
    `Prazo: ${tm.name}\n` +
    `Estimativa: ${eur(low)} a ${eur(high)}\n\n` +
    `Podemos falar sobre o meu projeto?`;
  $("#send").href = waLink(msg);
}

function waLink(text){ return "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + encodeURIComponent(text); }
document.querySelectorAll("[data-wa]").forEach(a => a.href = waLink(a.dataset.wa));
$("#yr").textContent = new Date().getFullYear();

// ===== AVALIAÇÕES =====
// Substitua pelos comentários e notas reais dos seus clientes e retire "demo:true".
// A média e o gráfico são calculados automaticamente a partir desta lista.
const REVIEWS = [
  {name:"Maria S.", role:"Clínica, Luanda", stars:5, text:"O site ficou exatamente como imaginámos e começámos a receber marcações logo na primeira semana.", demo:true},
  {name:"Carlos M.", role:"Loja de roupa, Benguela", stars:5, text:"Explicaram tudo com calma e entregaram dentro do prazo combinado.", demo:true},
  {name:"Ana P.", role:"Escola de formação, Luanda", stars:4, text:"Gostámos do resultado. A revisão final demorou um pouco mais do que esperávamos, mas ficou resolvida.", demo:true},
  {name:"João T.", role:"Restaurante, Huambo", stars:5, text:"Atendimento rápido no WhatsApp e um site simples de usar no telemóvel.", demo:true}
];

const starStr = n => "★".repeat(n) + "☆".repeat(5-n);
const esc = s => String(s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function paint(list){
  const n = list.length;
  if(!n){$("#rv").innerHTML="";$("#avg").textContent="–";$("#avgStars").textContent="";$("#cnt").textContent="Ainda sem avaliações";$("#dist").innerHTML="";return;}
  const avg = list.reduce((a,r)=>a+r.stars,0)/n;
  $("#avg").textContent = avg.toFixed(1).replace(".",",");
  $("#avgStars").textContent = starStr(Math.round(avg));
  $("#cnt").textContent = "Média de " + n + " avaliações" + (list.every(r=>r.demo) ? " (exemplos ilustrativos)" : "");
  let d = "";
  for(let s=5;s>=1;s--){
    const c = list.filter(r=>r.stars===s).length;
    d += `<div class="dist"><span>${s} ★</span><i><b style="width:${Math.round(c/n*100)}%"></b></i><span>${c}</span></div>`;
  }
  $("#dist").innerHTML = d;
  $("#rv").innerHTML = list.map(r => `<article class="rv"><div class="stars" role="img" aria-label="${r.stars} de 5 estrelas">${starStr(r.stars)}</div><p>“${esc(r.text)}”</p><div class="who">${esc(r.name)}${r.demo?'<span class="tag">Exemplo</span>':''}<small>${esc(r.role||"")}</small></div></article>`).join("");
}
paint(REVIEWS);

// Avaliações dos clientes (versão para o seu domínio, com Firebase Firestore)
// Preencha com os dados do seu projeto Firebase (ver instruções).
const FIREBASE = {projectId:"nuxes-loop2", apiKey:"AIzaSyAp5jw64NAcTj8mtMAeiqBKA9WBbELBHj4"};

(function(){
  const msg = t => $("#rvMsg").textContent = t;
  if(!FIREBASE.projectId || !FIREBASE.apiKey){
    $("#rvSend").disabled = true;
    msg("O envio de avaliações ainda não está configurado.");
    return;
  }
  const url = `https://firestore.googleapis.com/v1/projects/${FIREBASE.projectId}/databases/(default)/documents/reviews`;
  const val = f => f ? (f.stringValue !== undefined ? f.stringValue : Number(f.integerValue)) : undefined;

  async function load(){
    try{
      const r = await fetch(url + "?pageSize=100&key=" + FIREBASE.apiKey);
      const j = await r.json();
      const real = (j.documents||[]).map(d => ({
        name: val(d.fields.name), text: val(d.fields.text),
        stars: val(d.fields.stars), at: val(d.fields.at)
      })).filter(r => r.name && r.text && r.stars>=1 && r.stars<=5);
      real.sort((a,b) => (b.at||0)-(a.at||0));
      paint(real.length ? real : REVIEWS);
    }catch(e){}
  }
  load();

  $("#rvSend").addEventListener("click", async () => {
    const name = $("#rvName").value.trim();
    const text = $("#rvText").value.trim();
    const pick = document.querySelector('input[name="rvs"]:checked');
    if(!name || !pick || !text) return msg("Preencha o nome, escolha a nota e escreva o comentário.");
    $("#rvSend").disabled = true;
    try{
      const r = await fetch(url + "?key=" + FIREBASE.apiKey, {
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body: JSON.stringify({fields:{
          name:{stringValue:name}, text:{stringValue:text},
          stars:{integerValue:String(pick.value)}, at:{integerValue:String(Date.now())}
        }})
      });
      if(!r.ok) throw new Error();
      msg("Obrigado! A sua avaliação já está visível.");
      $("#rvText").value = "";
      load();
    }catch(e){ msg("Não foi possível publicar agora. Tente novamente."); }
    $("#rvSend").disabled = false;
  });
})();

render();
</script>
