<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Nuxes Loop Technology – Sites que vendem</title>
<meta name="description" content="Criação de sites institucionais, landing pages de alta conversão e lojas virtuais.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#f3f6f9; --surface:#ffffff; --ink:#0e1c2f; --muted:#52627a; --line:#d6dee8;
  --blue:#2455ff; --blue-ink:#ffffff; --wa:#14a866; --wa-ink:#ffffff; --soft:#e6edff;
  --display:"Bricolage Grotesque","Trebuchet MS",system-ui,sans-serif;
  --body:"DM Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#0a1220;--surface:#111c30;--ink:#eaf0fa;--muted:#9fb0c9;--line:#22324d;--blue:#6f93ff;--blue-ink:#0a1220;--soft:#18284a;--wa:#2bd08a;--wa-ink:#06241a}
}
:root[data-theme="dark"]{--bg:#0a1220;--surface:#111c30;--ink:#eaf0fa;--muted:#9fb0c9;--line:#22324d;--blue:#6f93ff;--blue-ink:#0a1220;--soft:#18284a;--wa:#2bd08a;--wa-ink:#06241a}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1rem/1.6 var(--body);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--display);line-height:1.1;margin:0;letter-spacing:-.02em}
h1{font-size:clamp(2.3rem,8vw,4.4rem);font-weight:800}
h2{font-size:clamp(1.7rem,5vw,2.6rem);font-weight:800;margin-bottom:.6rem}
h3{font-size:1.25rem;font-weight:600}
p{margin:0 0 1rem}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.wrap{width:min(1080px,100% - 2.5rem);margin-inline:auto}
section{padding:4.5rem 0}
.lead{color:var(--muted);max-width:60ch}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6rem;min-height:52px;padding:.85rem 1.5rem;border-radius:999px;border:0;font:700 1rem var(--body);cursor:pointer;text-decoration:none;transition:transform .15s}
.btn:active{transform:scale(.97)}
.btn-wa{background:var(--wa);color:var(--wa-ink)}
.btn-line{background:transparent;color:var(--ink);border:2px solid var(--line)}
.btn svg{width:22px;height:22px;fill:currentColor}

header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
.bar{display:flex;align-items:center;justify-content:space-between;min-height:64px}
.logo{display:flex;align-items:center;gap:.6rem;font:800 1.1rem var(--display);text-decoration:none}
.logo svg{width:30px;height:30px}
nav{display:flex;gap:1.4rem}
nav a{text-decoration:none;color:var(--muted);font-weight:500}
nav a:hover{color:var(--ink)}
@media(max-width:720px){nav{display:none}}

.hero{padding:3.5rem 0 4.5rem}
.hero-grid{display:grid;gap:2.5rem;align-items:center}
@media(min-width:860px){.hero-grid{grid-template-columns:1.25fr .75fr}}
.hero p.lead{font-size:1.15rem;margin:1.4rem 0 2rem}
.cta{display:flex;flex-wrap:wrap;gap:.8rem}
.loop{width:min(100%,340px);margin-inline:auto;display:block}
.loop .ring{fill:none;stroke:var(--blue);stroke-width:14;stroke-linecap:round;stroke-dasharray:520 120;transform-origin:center;animation:close 2.2s .3s cubic-bezier(.3,.7,.2,1) forwards}
.loop .ring2{fill:none;stroke:var(--line);stroke-width:14}
.loop text{font:800 22px var(--display);fill:var(--ink)}
@keyframes close{from{stroke-dasharray:380 260;transform:rotate(-60deg)}to{stroke-dasharray:640 0;transform:rotate(90deg)}}
@media(prefers-reduced-motion:reduce){.loop .ring{animation:none;stroke-dasharray:640 0}html{scroll-behavior:auto}}

.about{background:var(--surface);border-block:1px solid var(--line)}
.about-grid{display:grid;gap:2rem}
@media(min-width:860px){.about-grid{grid-template-columns:1fr 1fr;gap:4rem}}
.facts{display:grid;gap:1rem;align-content:start}
.facts div{border-left:4px solid var(--blue);padding-left:1rem}
.facts b{display:block;font-family:var(--display);font-size:1.15rem}
.facts span{color:var(--muted)}

.services{display:grid;gap:1.2rem;margin-top:2rem}
@media(min-width:860px){.services{grid-template-columns:repeat(3,1fr)}}
.svc{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:1.6rem}
.svc svg{width:34px;height:34px;stroke:var(--blue);fill:none;stroke-width:2;margin-bottom:1rem}
.svc p{color:var(--muted);margin:.5rem 0 0}

.calc{background:var(--soft)}
.calc-box{display:grid;gap:1.5rem;margin-top:2rem}
@media(min-width:900px){.calc-box{grid-template-columns:1.4fr 1fr;align-items:start}}
fieldset{border:0;margin:0 0 1.6rem;padding:0}
legend{font:600 1.1rem var(--display);margin-bottom:.8rem;padding:0}
.opts{display:grid;gap:.6rem}
@media(min-width:560px){.opts{grid-template-columns:1fr 1fr}}
.opt{position:relative}
.opt input{position:absolute;opacity:0;inset:0;cursor:pointer}
.opt label{display:flex;justify-content:space-between;gap:.8rem;align-items:center;min-height:54px;padding:.7rem 1rem;background:var(--surface);border:2px solid var(--line);border-radius:14px;cursor:pointer;font-weight:500}
.opt label small{color:var(--muted);font-weight:400;text-align:right;font-size:.85rem}
.opt input:checked+label{border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue)}
.opt input:focus-visible+label{outline:3px solid var(--blue);outline-offset:2px}
.sum{background:var(--ink);color:var(--bg);border-radius:20px;padding:1.6rem;position:sticky;top:calc(env(safe-area-inset-top,0px) + 80px)}
.sum h3{margin-bottom:1rem}
.sum ul{list-style:none;margin:0 0 1.2rem;padding:0;display:grid;gap:.4rem;font-size:.95rem}
.sum li{display:flex;justify-content:space-between;gap:1rem;border-bottom:1px dashed rgba(127,127,127,.4);padding-bottom:.4rem}
.price{font:800 2.2rem var(--display);line-height:1.1}
.sum .note{font-size:.85rem;opacity:.75;margin:.4rem 0 1.2rem}
.sum .btn{width:100%}

.cases{display:grid;gap:1.2rem;margin-top:2rem}
@media(min-width:860px){.cases{grid-template-columns:repeat(3,1fr)}}
.case{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:1.6rem;display:flex;flex-direction:column;gap:1rem}
.case h3{font-size:1.1rem}
.case dt{font:700 .95rem var(--display);color:var(--blue)}
.case dd{margin:.15rem 0 .9rem;color:var(--muted)}
.case dd.res{color:var(--ink);font-weight:700}

.stars{color:#c27500;letter-spacing:.08em;font-size:1.15rem;line-height:1}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) .stars{color:#ffc247}}
:root[data-theme="dark"] .stars{color:#ffc247}
.reviews{background:var(--surface);border-block:1px solid var(--line)}
.rv-top{display:grid;gap:1.5rem;margin:2rem 0}
@media(min-width:860px){.rv-top{grid-template-columns:.8fr 1.2fr;align-items:start}}
.rv-score{background:var(--bg);border:1px solid var(--line);border-radius:18px;padding:1.6rem}
.rv-num{font:800 3.4rem var(--display);line-height:1}
.rv-score .stars{margin:.5rem 0 .3rem;font-size:1.4rem}
.rv-score p{color:var(--muted);font-size:.9rem;margin:0 0 1rem}
.dist{display:grid;grid-template-columns:2.2rem 1fr 1.6rem;gap:.6rem;align-items:center;font-size:.85rem;color:var(--muted);margin-bottom:.35rem}
.dist i{display:block;height:8px;border-radius:99px;background:var(--line);overflow:hidden}
.dist i b{display:block;height:100%;background:var(--blue)}
.rv-rules{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
.rv-rules li{border-left:4px solid var(--blue);padding-left:1rem;color:var(--muted)}
.rv-rules b{display:block;color:var(--ink);font-family:var(--display);font-size:1.1rem}
.rv-grid{display:grid;gap:1.2rem}
@media(min-width:760px){.rv-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1000px){.rv-grid{grid-template-columns:repeat(3,1fr)}}
.rv{background:var(--bg);border:1px solid var(--line);border-radius:18px;padding:1.4rem;display:flex;flex-direction:column;gap:.8rem}
.rv p{margin:0;flex:1}
.rv .who{font-weight:700;display:flex;flex-wrap:wrap;gap:.2rem .6rem;align-items:center}
.rv .who small{color:var(--muted);font-weight:400;width:100%}
.tag{font:500 .75rem var(--body);background:var(--soft);color:var(--ink);border-radius:99px;padding:.1rem .6rem}
.rv-cta{margin-top:2rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between}
.rv-cta p{margin:0;font-weight:500;max-width:46ch}
.rv-form{margin-top:2rem;background:var(--bg);border:1px solid var(--line);border-radius:18px;padding:1.6rem;max-width:680px}
.rv-form>p{color:var(--muted)}
.field{display:grid;gap:.4rem;margin-bottom:1.2rem}
.field label{font-weight:600}
.field input,.field textarea{font:inherit;color:var(--ink);background:var(--surface);border:2px solid var(--line);border-radius:12px;padding:.8rem 1rem;width:100%}
.btn[disabled]{opacity:.5;cursor:not-allowed}
#rvMsg{margin:1rem 0 0;font-weight:500}
footer{padding:3rem 0;border-top:1px solid var(--line);text-align:center;color:var(--muted)}
footer .cta{justify-content:center;margin-bottom:1.5rem}
.fab{position:fixed;right:1rem;bottom:calc(1rem + env(safe-area-inset-bottom,0px));z-index:25;width:58px;height:58px;border-radius:50%;background:var(--wa);color:var(--wa-ink);display:grid;place-items:center;box-shadow:0 6px 20px rgba(0,0,0,.3)}
.fab svg{width:30px;height:30px;fill:currentColor}
</style>
</head>
<body>

